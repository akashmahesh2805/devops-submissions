pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('Exercise 9 - Jenkins Multi-Stage Pipeline') {
                    sh 'python3 -m venv .venv'
                    sh '.venv/bin/python -m pip install --disable-pip-version-check -r requirements.txt'
                }
            }
        }
        stage('Test') {
            steps {
                dir('Exercise 9 - Jenkins Multi-Stage Pipeline') {
                    sh '.venv/bin/python -m unittest discover -s . -p test_app.py'
                }
            }
        }
        stage('Deploy') {
            steps {
                dir('Exercise 9 - Jenkins Multi-Stage Pipeline') {
                    sh '''
                    mkdir -p python-app-deploy
                    cp app.py requirements.txt test_app.py python-app-deploy/
                    cd python-app-deploy
                    ../.venv/bin/python -m unittest discover -s . -p test_app.py
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for details.'
        }
    }
}
