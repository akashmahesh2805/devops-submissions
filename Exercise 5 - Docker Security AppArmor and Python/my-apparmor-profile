#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected) {
  #include <abstractions/base>

  /app/** r,
  /usr/local/bin/python* ix,
  /usr/local/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/lib/** mr,
  /etc/ld.so.cache r,
  /etc/localtime r,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/ssl/** r,
  /proc/** r,
  /dev/null rw,
  network inet stream,
  capability net_bind_service,

  deny /etc/passwd r,
  deny /etc/shadow r,
  deny /var/** rw,
  deny /bin/** x,
  deny /usr/bin/** x,
  deny capability sys_admin,
}
